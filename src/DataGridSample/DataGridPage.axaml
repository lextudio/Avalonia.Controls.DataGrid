<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DataGridSample"
             xmlns:converters="clr-namespace:DataGridSample.Converters"
             xmlns:models="clr-namespace:DataGridSample.Models"
             x:Class="DataGridSample.DataGridPage"
             x:DataType="local:DataGridPage">
  <UserControl.Resources>

    <converters:GDPValueConverter x:Key="GDPConverter" />
    <converters:GDPLengthConverter x:Key="GDPWidthConverter"/>
    <DataTemplate x:Key="Demo.DataTemplates.CountryHeader" x:DataType="models:Country">
      <StackPanel Orientation="Horizontal" Spacing="5">
        <PathIcon Height="12" Data="M 255 116 A 1 1 0 0 0 254 117 L 254 130 A 1 1 0 0 0 255 131 A 1 1 0 0 0 256 130 L 256 123.87109 C 256.1125 123.90694 256.2187 123.94195 256.33984 123.97852 C 257.18636 124.23404 258.19155 124.5 259 124.5 C 259.80845 124.5 260.52133 124.2168 261.17773 123.9668 C 261.83414 123.7168 262.43408 123.5 263 123.5 C 263.56592 123.5 264.5612 123.73404 265.37109 123.97852 C 266.18098 124.22299 266.82227 124.4668 266.82227 124.4668 A 0.50005 0.50005 0 0 0 267.5 124 L 267.5 118 A 0.50005 0.50005 0 0 0 267.17773 117.5332 C 267.17773 117.5332 266.50667 117.27701 265.66016 117.02148 C 264.81364 116.76596 263.80845 116.5 263 116.5 C 262.19155 116.5 261.47867 116.7832 260.82227 117.0332 C 260.16586 117.2832 259.56592 117.5 259 117.5 C 258.43408 117.5 257.4388 117.26596 256.62891 117.02148 C 256.39123 116.94974 256.17716 116.87994 255.98047 116.81445 A 1 1 0 0 0 255 116 z M 263 117.5 C 263.56592 117.5 264.5612 117.73404 265.37109 117.97852 C 266.00097 118.16865 266.29646 118.28239 266.5 118.35742 L 266.5 120.29297 C 266.25708 120.21012 265.97978 120.11797 265.66016 120.02148 C 264.81364 119.76596 263.80845 119.5 263 119.5 C 262.19155 119.5 261.47867 119.7832 260.82227 120.0332 C 260.16586 120.2832 259.56592 120.5 259 120.5 C 258.43408 120.5 257.4388 120.26596 256.62891 120.02148 C 256.39971 119.9523 256.19148 119.88388 256 119.82031 L 256 117.87109 C 256.1125 117.90694 256.2187 117.94195 256.33984 117.97852 C 257.18636 118.23404 258.19155 118.5 259 118.5 C 259.80845 118.5 260.52133 118.2168 261.17773 117.9668 C 261.83414 117.7168 262.43408 117.5 263 117.5 z M 263 120.5 C 263.56592 120.5 264.5612 120.73404 265.37109 120.97852 C 265.8714 121.12954 266.2398 121.25641 266.5 121.34961 L 266.5 123.30469 C 266.22286 123.20649 266.12863 123.1629 265.66016 123.02148 C 264.81364 122.76596 263.80845 122.5 263 122.5 C 262.19155 122.5 261.47867 122.7832 260.82227 123.0332 C 260.16586 123.2832 259.56592 123.5 259 123.5 C 258.43408 123.5 257.4388 123.26596 256.62891 123.02148 C 256.39971 122.9523 256.19148 122.88388 256 122.82031 L 256 120.87109 C 256.1125 120.90694 256.2187 120.94195 256.33984 120.97852 C 257.18636 121.23404 258.19155 121.5 259 121.5 C 259.80845 121.5 260.52133 121.2168 261.17773 120.9668 C 261.83414 120.7168 262.43408 120.5 263 120.5 z" />
        <TextBlock Text="{Binding}"/>
      </StackPanel>
    </DataTemplate>
    <ControlTheme x:Key="GdpCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}" x:DataType="models:Country">
      <Setter Property="Background" Value="{Binding Path=GDP, Mode=OneWay, Converter={StaticResource GDPConverter}}" />
    </ControlTheme>
  </UserControl.Resources>
  <UserControl.Styles>
    <!-- WPF-like hover/selection styling opt-in via class "wpf-theme" -->
    <Style Selector="DataGrid.wpf-theme DataGridRow:pointerover">
      <Setter Property="Background" Value="#FFE6F2FF"/>
    </Style>
    <Style Selector="DataGrid.wpf-theme DataGridRow:selected">
      <Setter Property="Background" Value="#FFCCE5FF"/>
      <Setter Property="BorderBrush" Value="#FF7AA2FF"/>
    </Style>
    <Style Selector="DataGrid.wpf-theme DataGridCell:pointerover">
      <Setter Property="Background" Value="#FFE6F2FF"/>
    </Style>
    <Style Selector="DataGrid.wpf-theme DataGridCell:selected">
      <Setter Property="Background" Value="#FFCCE5FF"/>
      <Setter Property="BorderBrush" Value="#FF7AA2FF"/>
    </Style>
    <Style Selector="DataGrid.wpf-theme DataGridColumnHeader:pointerover">
      <Setter Property="Background" Value="#FFE6F2FF"/>
    </Style>
    <Style Selector="DataGrid.wpf-theme DataGridColumnHeader:pressed">
      <Setter Property="Background" Value="#FFCCE5FF"/>
    </Style>
    <Style Selector="HyperlinkButton.LinkButton">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <ControlTemplate TargetType="HyperlinkButton">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="0"
                  Padding="0">
            <TextBlock Text="{TemplateBinding Content}"
                       Foreground="{TemplateBinding Foreground}"
                       TextDecorations="Underline"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="HyperlinkButton.LinkButton:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource AccentColor2}"/>
    </Style>
    <Style Selector="HyperlinkButton.LinkButton:pressed">
      <Setter Property="Opacity" Value="0.7"/>
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,*">
    <StackPanel Orientation="Vertical" Spacing="4" Grid.Row="0">
      <TextBlock Classes="h2">A control for displaying and interacting with a data source.</TextBlock>
    </StackPanel>
    <StackPanel Grid.Row="1" Spacing="4" Orientation="Horizontal" IsVisible="{Binding #EditableTab.IsSelected}">
      <TextBlock Text="FontSize:" VerticalAlignment="Center"/>
      <Slider x:Name="FontSizeSlider" Minimum="5" Maximum="30" Value="14" Width="100" VerticalAlignment="Center" />
      <CheckBox x:Name="IsThreeStateCheckBox" IsChecked="False" Content="IsThreeState"/>
    </StackPanel>
    <TabControl Grid.Row="2">
      <TabItem Header="DataGrid">
        <DockPanel>
          <StackPanel Orientation="Horizontal"
                      DockPanel.Dock="Top"
                      Spacing="5">
            <CheckBox x:Name="WpfThemeToggle" IsChecked="False" Content="Use WPF-ish styling" Checked="OnWpfThemeChanged" Unchecked="OnWpfThemeChanged"/>
            <CheckBox x:Name="ShowGDP" IsChecked="True" Content="Toggle GDP Column Visibility"/>
            <TextBlock Text="GDP Width:" VerticalAlignment="Center"/>
            <NumericUpDown x:Name="GDPWidth"
                    Minimum="200"
                    Maximum="350"
                    Width="200"
                    Increment="10"
                    Value="200"/>
            <!-- Inline filter row has been removed; popup filter button in column header is always available. -->
            <CheckBox x:Name="ShowDetailsToggle" IsChecked="True" Content="Show Row Details"/>
            <TextBlock Text="Details if GDP ≥" VerticalAlignment="Center"/>
            <NumericUpDown x:Name="DetailsThreshold"
                           Width="160"
                           HorizontalContentAlignment="Stretch"
                           Minimum="0"
                           Maximum="50000"
                           Increment="1000"
                           Value="15000"/>
          </StackPanel>
          <DataGrid Name="dataGrid1" Margin="12" CanUserResizeColumns="True" CanUserReorderColumns="True" CanUserSortColumns="True" HeadersVisibility="All"
                    RowBackground="#1000"
                    RowDetailsVisibilityMode="Visible">
            <DataGrid.Styles>
              <Style Selector="DataGridRow">
                <Setter Property="Header" Value="{Binding $self.Index}"/>
              </Style>
            </DataGrid.Styles>
            <DataGrid.Columns>
              <!-- Using HeaderTemplate -->
              <DataGridTextColumn Header="Country or Region" HeaderTemplate="{StaticResource Demo.DataTemplates.CountryHeader}" Binding="{Binding Name}"  Width="6*" x:DataType="models:Country" />
              <DataGridTextColumn Header="Region" Binding="{Binding Region}" Width="4*" x:DataType="models:Country" />
              <DataGridTextColumn Header="Population" Binding="{Binding Population}" Width="3*" x:DataType="models:Country" />
              <DataGridTextColumn Header="Area" Binding="{Binding Area}" Width="3*" x:DataType="models:Country" />
              <DataGridTextColumn Header="GDP" Binding="{Binding GDP}"
                                  Width="{Binding #GDPWidth.Value, Mode=TwoWay, Converter={StaticResource GDPWidthConverter}}"
                                  CellTheme="{StaticResource GdpCell}"
                                  MinWidth="200"
                                  MaxWidth="350"
                                  IsVisible="{Binding #ShowGDP.IsChecked}"
                                  x:DataType="models:Country" />
              <DataGridTemplateColumn Header="More">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="models:Country">
                    <HyperlinkButton Content="Open details"
                                     Command="{Binding DataContext.ShowCountryDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                     CommandParameter="{Binding Name}"
                                     Classes="LinkButton"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
            <DataGrid.CellTheme>
              <ControlTheme TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                <ControlTheme.Children>
                  <Style Selector="^:nth-child(1)">
                    <Setter Property="FontWeight" Value="Bold" />
                  </Style>
                </ControlTheme.Children>
              </ControlTheme>
            </DataGrid.CellTheme>
            <DataGrid.ColumnHeaderTheme>
              <ControlTheme TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                <ControlTheme.Children>
                  <Style Selector="^:nth-child(1)">
                    <Setter Property="FontWeight" Value="Bold" />
                  </Style>
                </ControlTheme.Children>
              </ControlTheme>
            </DataGrid.ColumnHeaderTheme>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="Grouping">
        <DataGrid Name="dataGridGrouping" Margin="12">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Country or Region" Binding="{Binding Name}" Width="6*" x:DataType="models:Country" />
            <DataGridTextColumn Header="Region" Binding="{Binding Region}" Width="4*" x:DataType="models:Country" />
            <DataGridTextColumn DisplayIndex="3" Header="Population" Binding="{Binding Population}" Width="3*" x:DataType="models:Country" />
            <DataGridTextColumn DisplayIndex="2" Header="Area" Binding="{Binding Area}" Width="3*" x:DataType="models:Country" />
            <DataGridTextColumn Header="GDP" Binding="{Binding GDP}" Width="3*" x:DataType="models:Country" />
          </DataGrid.Columns>
          <DataGrid.RowTheme>
            <ControlTheme TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
              <ControlTheme.Children>
                <Style Selector="^:nth-child(5n+3)">
                  <Setter Property="Foreground" Value="Red" />
                  <Setter Property="FontWeight" Value="Bold" />
                </Style>
                <Style Selector="^:nth-last-child(5n+1)">
                  <Setter Property="Foreground" Value="Blue" />
                  <Setter Property="FontWeight" Value="Bold" />
                </Style>
              </ControlTheme.Children>
            </ControlTheme>
          </DataGrid.RowTheme>
        </DataGrid>
      </TabItem>
      <TabItem x:Name="EditableTab" Header="Editable">
        <Grid RowDefinitions="*,Auto">
          <!-- Example of columns inheriting the data type from the Items source -->
          <DataGrid Name="dataGridEdit" Margin="12" Grid.Row="0"
                    ItemsSource="{Binding DataGrid3Source}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="First Name" Binding="{Binding FirstName}" Width="2*" FontSize="{Binding #FontSizeSlider.Value, Mode=OneWay}" />
              <DataGridTextColumn Header="Last" Binding="{Binding LastName}" Width="2*" FontSize="{Binding #FontSizeSlider.Value, Mode=OneWay}" />
              <DataGridCheckBoxColumn Header="Is Banned" Binding="{Binding IsBanned}" Width="*" IsThreeState="{Binding #IsThreeStateCheckBox.IsChecked, Mode=OneWay}" />
              <DataGridTemplateColumn Header="Age">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Age, StringFormat='{}{0} years'}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
                <DataGridTemplateColumn.CellEditingTemplate>
                  <DataTemplate>
                    <NumericUpDown Value="{Binding Age}" FormatString="N0" HorizontalAlignment="Stretch" Minimum="0" Maximum="120" TemplateApplied="NumericUpDown_OnTemplateApplied" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellEditingTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <Button Grid.Row="1" Name="btnAdd" Margin="12,0,12,12" Content="Add" HorizontalAlignment="Right" />
        </Grid>
      </TabItem>

      <TabItem Header="Filters (Hex &amp; Flags)">
        <TabItem.Resources>
          <ControlTemplate x:Key="OffsetFilterTemplate" TargetType="DataGridColumnHeader">
            <StackPanel Spacing="4">
              <TextBlock Text="Offset (hex)" />
              <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" Spacing="6" DockPanel.Dock="Left" VerticalAlignment="Center">
                  <TextBlock Text="0x" VerticalAlignment="Center"/>
                </StackPanel>
                <Grid HorizontalAlignment="Left">
                  <TextBox x:Name="OffsetFilterTextBox" Width="140"
                           Watermark="20"
                           TextChanged="OnOffsetFilterChanged"/>
                  <Button Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                          Click="OnClearOffsetFilter"
                          Background="Transparent"
                          BorderBrush="Transparent"
                          IsVisible="{Binding OwningColumn.FilterValue, RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}, Converter={StaticResource StringNotEmptyToVisibleConverter}}">
                    <Path Data="M3,3 L13,13 M13,3 L3,13" Stretch="Uniform" Stroke="Black" StrokeThickness="1.5" />
                  </Button>
                </Grid>
              </DockPanel>
            </StackPanel>
          </ControlTemplate>

          <DataTemplate x:Key="FlagsFilterTemplate">
            <StackPanel Spacing="4">
              <TextBlock Text="Flags (bitmask)" />
              <WrapPanel>
                <TextBox Width="140"
                         Watermark="0x3 or 3"
                         Text="{Binding FilterValue, RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}, Mode=TwoWay}"
                         TextChanged="OnFlagsFilterChanged"/>
                <Button Content="Clear" Click="OnClearFlagsFilter"/>
              </WrapPanel>
              <WrapPanel>
                <TextBlock VerticalAlignment="Center" Text="Quick bits:"/>
                <CheckBox Content="0x1" Tag="1" Checked="OnFlagCheckChanged" Unchecked="OnFlagCheckChanged"/>
                <CheckBox Content="0x2" Tag="2" Checked="OnFlagCheckChanged" Unchecked="OnFlagCheckChanged"/>
                <CheckBox Content="0x4" Tag="4" Checked="OnFlagCheckChanged" Unchecked="OnFlagCheckChanged"/>
                <CheckBox Content="0x8" Tag="8" Checked="OnFlagCheckChanged" Unchecked="OnFlagCheckChanged"/>
                <ComboBox Width="120" PlaceholderText="Presets" SelectionChanged="OnFlagPresetChanged">
                  <ComboBoxItem Content="0x3" Tag="3"/>
                  <ComboBoxItem Content="0x7" Tag="7"/>
                  <ComboBoxItem Content="0xF" Tag="15"/>
                </ComboBox>
                <ComboBox Width="160" PlaceholderText="Bitmask type" SelectionChanged="OnFlagTypeChanged">
                  <ComboBoxItem Content="Lower nybble (0-3)" Tag="LowerNybble"/>
                  <ComboBoxItem Content="Upper nybble (4-7)" Tag="UpperNybble"/>
                  <ComboBoxItem Content="Full byte (0-7)" Tag="FullByte"/>
                </ComboBox>
              </WrapPanel>
              <TextBlock FontSize="11" Foreground="Gray" Text="Pick bits or presets; multiple bits combine with AND."/>
            </StackPanel>
          </DataTemplate>

          <DataTemplate x:Key="RegexFilterTemplate">
            <StackPanel Spacing="4">
              <TextBlock Text="Description (regex)" />
              <TextBox Width="200"
                       Watermark="^Item [0-9]"
                       Text="{Binding FilterValue, RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}, Mode=TwoWay}"
                       TextChanged="OnRegexFilterChanged"/>
              <TextBlock x:Name="RegexStatus" FontSize="11" Foreground="Gray" Text="Enter a regex; invalid patterns fallback to contains."/>
            </StackPanel>
          </DataTemplate>
        </TabItem.Resources>
        <DockPanel Margin="12">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <TextBlock VerticalAlignment="Center" Text="Row index:"/>
            <NumericUpDown x:Name="FilterDemoIndex" Minimum="0" Maximum="100" Width="140" Value="5"/>
            <Button Content="Scroll Into View" Click="OnScrollFilterDemo"/>
            <Button Content="Select Item" Click="OnSelectFilterDemo"/>
            <CheckBox x:Name="HoverTooltipToggle" IsChecked="True" Content="Show hover tooltip"/>
          </StackPanel>
          <TextBlock DockPanel.Dock="Top" x:Name="HitTestInfo" Margin="0,0,0,8" Text="Click a cell to see hit info."/>
          <DataGrid Name="dataGridFilters"
                    CanUserResizeColumns="True"
                    PointerPressed="OnFiltersPointerPressed"
                    PointerMoved="OnFiltersPointerMoved"
                    PointerExited="OnFiltersPointerExited">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
              <DataGridTextColumn Header="Index" Binding="{Binding Index}" Width="*"
                                  FilterKind="Numeric">
                <DataGridTextColumn.FilterControlTemplate>
                  <DataTemplate>
                    <StackPanel Spacing="4">
                      <TextBlock Text="Index range (min..max or operators)"/>
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <NumericUpDown x:Name="IndexMin" Width="90" Minimum="0" Maximum="100" ValueChanged="OnIndexFilterChanged"/>
                        <TextBlock VerticalAlignment="Center" Text=".."/>
                        <NumericUpDown x:Name="IndexMax" Width="90" Minimum="0" Maximum="100" ValueChanged="OnIndexFilterChanged"/>
                        <Button Content="Clear" Click="OnClearIndexFilter"/>
                      </StackPanel>
                      <TextBlock FontSize="11" Foreground="Gray" Text="You can also type &gt;10, &lt;=5, or 10..20."/>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTextColumn.FilterControlTemplate>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Offset (try 0x20 or 32)" Binding="{Binding OffsetHex}" Width="*"
                                  FilterKind="Hex">
                <DataGridTextColumn.FilterControlTemplate>
                  <DataTemplate>
                    <ContentControl Template="{StaticResource OffsetFilterTemplate}"/>
                  </DataTemplate>
                </DataGridTextColumn.FilterControlTemplate>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Flags (try 4 or 8)" Binding="{Binding Flags}" Width="2*" MinWidth="240"
                                  FilterKind="Flags" />
              <DataGridTextColumn Header="Description (regex supported)" Binding="{Binding Description}" Width="3*" MinWidth="220"
                                  FilterKind="Regex" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
